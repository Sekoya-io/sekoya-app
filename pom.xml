<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.iglooproject.parents</groupId>
    <artifactId>igloo-parent-core-project</artifactId>
    <version>7.4.0</version>
    <relativePath/>
  </parent>
  <groupId>sekoya</groupId>
  <artifactId>sekoya</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>Sekoya</name>
  <modules>
    <module>sekoya-back</module>
    <module>sekoya-front</module>
    <module>sekoya-app</module>
    <module>sekoya-static</module>
  </modules>
  <properties>
    <igloo.version>7.4.0</igloo.version>
    <revision>0.0.1-SNAPSHOT</revision>
    <commonmark.version>0.30.0</commonmark.version>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <!--java25 spotless-->
    <google.java.format.version>1.35.0</google.java.format.version>
    <maplibre.version>5.24.0</maplibre.version>
    <!--pas de publication d'image par défaut-->
    <spring-boot.build-image.publish>false</spring-boot.build-image.publish>
  </properties>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <configuration>
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <scm>
    <developerConnection>scm:git:git@gitlab.tools.kobalt.fr:kobalt/${projectName}.git</developerConnection>
    <url>https://gitlab.tools.kobalt.fr/kobalt/${projectName}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitLab</system>
    <url>https://gitlab.tools.kobalt.fr/kobalt/${projectName}/issues</url>
  </issueManagement>
  <ciManagement>
    <system>GitLab</system>
    <url>https://gitlab.tools.kobalt.fr/kobalt/${projectName}/pipelines</url>
  </ciManagement>
  <repositories>
    <repository>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>nexus-igloo-releases</id>
      <name>Nexus Igloo Releases</name>
      <url>https://nexus.tools.kobalt.fr/repository/igloo-releases/</url>
    </repository>
    <repository>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
      <id>nexus-igloo-snapshots</id>
      <name>Nexus Igloo Snapshots</name>
      <url>https://nexus.tools.kobalt.fr/repository/igloo-snapshots/</url>
    </repository>
  </repositories>
  <profiles>
    <profile>
      <!-- override runImage for spring-boot-maven-plugin:build-image -->
      <!-- provided image contains minimal shell (/bin/bash, ...) -->
      <id>image-shell</id>
      <activation>
        <property>
          <name>image.shell.enabled</name>
        </property>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-maven-plugin</artifactId>
              <configuration>
                <image>
                  <!-- use ubuntu-noble-run in place of ubuntu-noble-run-tiny -->
                  <runImage>docker.io/paketobuildpacks/ubuntu-noble-run:latest</runImage>
                </image>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
